DATABASE_URL="postgresql://becomeuser:becomepass@localhost:5432/projectbecome?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Gating thresholds (mirror the design's tweakable defaults)
GATE_AUDIT_MIN_CHARS=300
GATE_JOURNAL_DAYS=7
GATE_HABIT_DAYS=14
GATE_CONSISTENCY_DAYS=30

# Set to "true" to expose the /api/dev/* persona fast-forward endpoints.
# Never enable this in production.
ENABLE_DEV_TOOLS=true
